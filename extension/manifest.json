{
  "manifest_version": 3,
  "name": "Vega · 期刊收录标签",
  "version": "1.0.2",
  "short_description": "在知网、Web of Science 等学术平台直接显示 CSSCI / CSCD / 北核 / 中科院分区收录标签。",
  "description": "在知网、Web of Science、Google 学术等学术检索平台，直接在刊名旁显示公开收录信息：CSSCI 来源版/扩展版、CSCD 核心库/扩展库、北大核心、中科院大类分区 1–4 区（含 Top 与小类分区），以及国际期刊预警名单。\n\n点击标签查看 ISSN、学科、收录目录、分区明细和预警信息。支持逐项显示开关、清新默认配色、自定义配色，以及浅色/深色/跟随系统的界面主题。工具栏图标直接打开完整圆角设置浮层；浏览器限制页面打开独立设置页。\n\n数据版本：CSSCI 2025–2026、CSCD 2025–2026、北大核心期刊要目总览、中科院分区 2025 终版、国际期刊预警 2020–2025 累计。收录信息以相应目录和公告为准。\n\n全部数据内置，本地运行，不访问外部服务，不收集、不上传浏览记录或检索内容。",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://kns.cnki.net/*",
    "https://www.cnki.net/*",
    "https://*.webofscience.com/*",
    "https://*.clarivate.com/*",
    "https://scholar.google.com/*",
    "https://scholar.google.com.hk/*",
    "https://scholar.google.co.jp/*",
    "https://scholar.google.co.uk/*",
    "https://xueshu.baidu.com/*",
    "https://www.sciencedirect.com/*",
    "https://pubmed.ncbi.nlm.nih.gov/*",
    "https://link.springer.com/*",
    "https://www.semanticscholar.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kns.cnki.net/*",
        "https://www.cnki.net/*",
        "https://*.webofscience.com/*",
        "https://*.clarivate.com/*",
        "https://scholar.google.com/*",
        "https://scholar.google.com.hk/*",
        "https://scholar.google.co.jp/*",
        "https://scholar.google.co.uk/*",
        "https://xueshu.baidu.com/*",
        "https://www.sciencedirect.com/*",
        "https://pubmed.ncbi.nlm.nih.gov/*",
        "https://link.springer.com/*",
        "https://www.semanticscholar.org/*"
      ],
      "js": [
        "core/judge.js",
        "core/themes.js",
        "sites/index.js",
        "content.js",
        "settings-panel.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Vega · 期刊收录标签"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "style.css",
        "data/journals.json",
        "data/cas_detail.json",
        "selftest.html",
        "selftest.js",
        "core/judge.js",
        "sites/index.js"
      ],
      "matches": [
        "https://kns.cnki.net/*",
        "https://www.cnki.net/*",
        "https://*.webofscience.com/*",
        "https://*.clarivate.com/*",
        "https://scholar.google.com/*",
        "https://scholar.google.com.hk/*",
        "https://scholar.google.co.jp/*",
        "https://scholar.google.co.uk/*",
        "https://xueshu.baidu.com/*",
        "https://www.sciencedirect.com/*",
        "https://pubmed.ncbi.nlm.nih.gov/*",
        "https://link.springer.com/*",
        "https://www.semanticscholar.org/*"
      ]
    },
    {
      "resources": [
        "popup/popup.html",
        "popup/boot.js",
        "popup/popup.js",
        "popup/panel.js",
        "icon32.png",
        "core/themes.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
